@page "/tramite/"
@page "/tramite/{Id:guid}"

@using CRM.Dtos
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-10">
    <MudPaper Elevation="4" Class="pa-8" Style="border-radius: 12px;">
        
        @* --- CABECERA --- *@
        <div class="d-flex align-center mb-6">
            <MudIcon Icon="@(_isEdit ? Icons.Material.Filled.EditNote : Icons.Material.Filled.AddBox)" 
                     Size="Size.Large" Color="Color.Primary" Class="mr-3" />
            <div>
                <MudText Typo="Typo.h4" Style="font-weight: 700;">@(_isEdit ? "Editar Trámite" : "Nuevo Trámite Masivo")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Gestión centralizada de certificaciones y barcos</MudText>
            </div>
        </div>

        <MudDivider Class="mb-6" />

        <MudForm @ref="_form" @bind-IsValid="@_success">
            <MudGrid Spacing="4">
                
                @* --- COLUMNA IZQUIERDA: DATOS TRÁMITE --- *@
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3 font-weight-bold">Información General</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Título del Trámite" Variant="Variant.Outlined"
                                          @bind-Value="_masivoDto.Tramite.NombreTramite"
                                          Required="true" RequiredError="El título es obligatorio"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Label" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Observaciones / Comentarios" 
                                          Variant="Variant.Outlined"
                                          @bind-Value="_masivoDto.Tramite.Observaciones"
                                          Lines="5" Placeholder="Notas adicionales sobre este trámite..." />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                @* --- COLUMNA DERECHA: FECHAS --- *@
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3 font-weight-bold">Plazos y Vigencia</MudText>
                    <MudPaper Variant="Variant.Outlined" Class="pa-4" Style="background-color: var(--mud-palette-background-grey);">
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudDatePicker Label="Fecha de Inicio" Editable="true"
                                               @bind-Date="_masivoDto.Tramite.FechaInicio" 
                                               AdornmentColor="Color.Primary" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudDatePicker Label="Fecha de Expiración" Editable="true"
                                               @bind-Date="_masivoDto.Tramite.FechaFin" 
                                               AdornmentColor="Color.Error" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                @* --- SECCIÓN ASIGNACIÓN (Sólo Creación) --- *@
                @if (true)
                {
                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                        <div class="d-flex align-center gap-2 mb-4">
                            <MudText Typo="Typo.h6" Style="font-weight: bold;">Configuración de Envío</MudText>
                            <MudChip T="string" Color="Color.Info" 
                                Size="Size.Small" Variant="Variant.Text">Cofradía</MudChip>
                        </div>
                        
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.GroupAdd">
                            Selecciona si deseas aplicar este trámite a toda la flota o solo a barcos específicos.
                        </MudAlert>

                        <div class="d-flex align-center mb-4">
                            <MudSwitch @bind-Value="_masivoDto.TodosLosBarcos"
                                       Label="@(_masivoDto.TodosLosBarcos ? "Modo: Toda la flota" : "Modo: Selección manual")"
                                       Color="Color.Primary" ThumbIcon="@(_masivoDto.TodosLosBarcos ? Icons.Material.Filled.DoneAll : Icons.Material.Filled.PersonSearch)" />
                        </div>

                        @if (!_masivoDto.TodosLosBarcos)
                        {
                            <MudPaper Variant="Variant.Outlined" Class="pa-4 border-dashed" Style="border: 2px dashed #ccc;">
                                <div class="d-flex justify-space-between align-center mb-4">
                                    <MudText Typo="Typo.body1" Style="font-weight: 500;">
                                        Barcos Seleccionados: <b>@_empresasSeleccionadas.Count()</b>
                                    </MudText>
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.DirectionsBoat"
                                               OnClick="AbrirSelectorEmpresas"
                                               Size="Size.Small">
                                        Explorar y añadir barcos
                                    </MudButton>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    @if (!_empresasSeleccionadas.Any())
                                    {
                                        <div class="d-flex align-center justify-center w-100 py-8 mud-text-secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="mr-2" />
                                            <MudText Typo="Typo.body2">Aún no has seleccionado ningún barco para este trámite</MudText>
                                        </div>
                                    }
                                    @foreach (var barco in _empresasSeleccionadas)
                                    {
                                        <MudChip T="EmpresasDto" Variant="Variant.Filled"
                                                 OnClose="@(() => QuitarEmpresa(barco))"
                                                 Color="Color.Primary" 
                                                 Icon="@Icons.Material.Filled.Anchor">
                                            <b>@barco!.NombreB</b> <span class="ml-2" style="opacity: 0.7; font-size: 0.8rem;">(@barco.CodigoBarco)</span>
                                        </MudChip>
                                    }
                                </div>
                            </MudPaper>
                        }
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-4">
                            Los cambios en esta pantalla solo afectan a la definición del trámite, no a las asignaciones individuales existentes.
                        </MudAlert>
                    </MudItem>
                }

                @* --- BOTONERA --- *@
                <MudItem xs="12" Class="d-flex justify-end gap-3 mt-6">
                    <MudButton Variant="Variant.Text" OnClick="Volver" Size="Size.Large">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(!_success || (!_masivoDto.TodosLosBarcos && !_empresasSeleccionadas.Any()))" 
                               OnClick="Guardar"
                               Style="min-width: 200px;">
                        @(_isEdit ? "Guardar Cambios" : "Crear y Asignar Trámite")
                    </MudButton>
                </MudItem>

            </MudGrid>
        </MudForm>
    </MudPaper>
</MudContainer>

<style>
    .border-dashed {
        border-radius: 8px;
        background-color: #fafafa;
    }
    .font-weight-bold {
        font-weight: 600;
    }
</style>