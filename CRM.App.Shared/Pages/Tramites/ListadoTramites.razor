@page "/tramites"
@using CRM.Dtos
@using MudBlazor
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Linq
@using System.ComponentModel.DataAnnotations 
@using System.ComponentModel.DataAnnotations.Schema 

@* ... Cabecera igual ... *@

<div class="d-flex gap-4 mt-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AgregarTramite">
        Crear Nuevo Trámite
    </MudButton>

@*     @if (_selectedItems != null && _selectedItems.Any())
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="BorrarSeleccionados">
            Borrar Seleccionados (@_selectedItems.Count)
        </MudButton>
    } *@
</div>

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudDataGrid Items="@Tramites" T="TramiteDto"
                 MultiSelection="true" @bind-SelectedItems="_selectedItems"
                 Filterable="true" QuickFilter="@QuickFilter"
                 Hideable="true" Striped="true" Dense="true" Bordered="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Listado de Trámites</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Buscar por código o nombre..."
                          Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
        </ToolBarContent>
        <Columns>
            @* Columna de Selección Masiva *@
            @* <SelectColumn T="TramiteDto" /> 

            <PropertyColumn Property="x => x.Codigo" Title="Código" Sortable="true" />*@
            <PropertyColumn Property="x => x.NombreTramite" Title="Descripción" />
            <PropertyColumn Property="x => x.FechaInicio" Title="Fecha Inicio" Format="dd/MM/yyyy" />
            <PropertyColumn Property="x => x.FechaFin" Title="Fecha Fin" Format="dd/MM/yyyy" />

            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                Size="Size.Small" 
                                OnClick="@(() => EditTramite(context.Item.Id))" />
                    </MudTooltip>
@*                     <MudTooltip Text="Eliminar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteTramite(context.Item.Id, context.Item.NombreTramite))" />
                    </MudTooltip> *@
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TramiteDto" RowsPerPageString="Filas por página:" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>