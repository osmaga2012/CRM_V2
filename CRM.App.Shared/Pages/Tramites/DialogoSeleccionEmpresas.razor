@using CRM.Dtos
@using MudBlazor

@inject IApiClient<EmpresasDto> servicioEmpresas
@inject IApiClient<BarcosDto> servicioBarcos

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Seleccionar Empresas y Barcos</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <!-- Autocomplete para búsqueda con Enter para agregar -->
            <MudAutocomplete
                 T="EmpresasDto"
                 Label="Buscar Empresas/Barcos"
                 Value ="_empresaSeleccionada"
                 SearchFunc="BuscarEmpresas"
                 ToStringFunc="GetDescripcionBarco"
                 Variant="Variant.Outlined"
                 Adornment="Adornment.End"
                 AdornmentIcon="@Icons.Material.Outlined.Search"
                 Clearable="true"
                 MaxItems="100"
                 Dense="false"
                 ResetValueOnEmptyText="false"            
                 CoerceText="false"            
                 CoerceValue="false"
                 ShowProgressIndicator="true"
                 ValueChanged="OnEmpresaSeleccionada" 
                 Strict="false">
               <ItemTemplate context="empresa">
                    <MudStack row
                              Spacing="2"
                              AlignItems="AlignItems.Start" class="py-1">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.body2"><b>@empresa.Empresa</b></MudText>
                    </MudStack>
                   <MudStack row 
                       Spacing="2" 
                       AlignItems="AlignItems.Start" class="py-1">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                        
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @empresa.CodigoBarco • @(GetDescripcionBarco(empresa.Barco!))
                        </MudText>
                   </MudStack>

               </ItemTemplate>
             
             
             </MudAutocomplete>

@*             <MudAutocomplete T="EmpresasDto"
                             @ref="_autocomplete"
                             Label="Buscar barcos"
                             Placeholder="Escribe para buscar y presiona Enter para agregar..."
                             Value="_empresaSeleccionada"
                             SearchFunc="BuscarEmpresas"
                             ToStringFunc="GetDescripcionBarco"
                             Variant="Variant.Outlined"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             Clearable="true"
                             MaxItems="100"
                             Dense="false"
                             ResetValueOnEmptyText="false"
                             CoerceText="false"
                             CoerceValue="false"
                             ShowProgressIndicator="true"
                             ValueChanged="OnEmpresaSeleccionada"
                             Strict="false">
                <ItemTemplate Context="barco">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="py-1">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Small" Color="Color.Primary" />
                        <MudStack Spacing="0" Justify="Justify.FlexStart">
                            <MudText Typo="Typo.body2"><b>@barco.NombreB</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @barco.CodigoBarco • @(GetNombreEmpresa(barco.CodigoEmpresa))
                            </MudText>
                        </MudStack>
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
 *@
            <!-- Chips de barcos seleccionados -->
            @if (_tempSeleccionBarcos.Any())
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudText Typo="Typo.subtitle2">
                            <b>Barcos seleccionados (@_tempSeleccionBarcos.Count)</b>
                        </MudText>
                        <MudButton OnClick="LimpiarTodo" 
                                   Size="Size.Small" 
                                   Variant="Variant.Text" 
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Clear">
                            Limpiar todo
                        </MudButton>
                    </MudStack>
                    
                    <MudChipSet T="string" AllClosable="true" OnClose="RemoverBarcoPorCodigo">
                        @foreach (var barco in _tempSeleccionBarcos.OrderBy(b => b.NombreB))
                        {
                            <MudChip T="string" 
                                     Value="@barco.CodigoBarco.ToString()"
                                     Color="Color.Primary" 
                                     Variant="Variant.Filled"
                                     Icon="@Icons.Material.Filled.DirectionsBoat">
                                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">@barco.NombreB</MudText>
                                    @if (!string.IsNullOrWhiteSpace(barco.CodigoBarco.ToString()))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">(@barco.CodigoBarco)</MudText>
                                    }
                                </MudStack>
                            </MudChip>
                        }
                    </MudChipSet>
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Info">
                    <MudText>Busca un barco y presiona <b>Enter</b> o haz clic para agregarlo a la selección.</MudText>
                </MudAlert>
            }

            <!-- Panel de configuración de emails -->
            @if (_tempSeleccionBarcos.Any())
            {
                <MudExpansionPanels MultiExpansion="false" Elevation="1">
                    <MudExpansionPanel IsInitiallyExpanded="false">
                        <TitleContent>
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Email" />
                                <MudText>Configurar Emails de Notificación</MudText>
                                @{
                                    var sinEmail = _tempSeleccionBarcos.Count(b => b.Empresa == null ||
                                    string.IsNullOrWhiteSpace(b.Empresa!.EMail1!) && string.IsNullOrWhiteSpace(b.Empresa!.EMail2!));
                                }
                                @if (sinEmail > 0)
                                {
                                    <MudChip T="int" Size="Size.Small" Color="Color.Warning">
                                        @sinEmail sin email
                                    </MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                Los barcos sin email configurado no recibirán notificaciones automáticas.
                            </MudAlert>
                            
                            <MudTable Items="@_tempSeleccionBarcos.OrderBy(b => b.NombreB)" 
                                      Dense="true" 
                                      Hover="true" 
                                      Breakpoint="Breakpoint.Sm" 
                                      Elevation="0"
                                      FixedHeader="true"
                                      Height="300px">
                                <HeaderContent>
                                    <MudTh><MudTableSortLabel SortBy="new Func<BarcosDto, object>(x => x.NombreB)">Barco</MudTableSortLabel></MudTh>
                                    <MudTh>Empresa</MudTh>
                                    <MudTh>Email Principal</MudTh>
                                    <MudTh>Email Secundario</MudTh>
                                    <MudTh Style="text-align: center;">Estado</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Barco">@context.NombreA</MudTd>
                                    <MudTd DataLabel="Email 1">
                                        <MudTextField 
                                            @bind-Value="context.Empresa.EMail1" 
                                            Margin="Margin.Dense" 
                                            Variant="Variant.Outlined" 
                                            Placeholder="Vacío" />
                                    </MudTd>
                                    <MudTd DataLabel="Email 2">
                                        <MudTextField @bind-Value="context.Empresa.EMail2" 
                                                        Margin="Margin.Dense" 
                                                        Variant="Variant.Outlined" 
                                                        Placeholder="Vacío" />
                                    </MudTd>
                                    <MudTd>
                                        @if (string.IsNullOrEmpty(context.Empresa.EMail1) && string.IsNullOrEmpty(context.Empresa.EMail2))
                                        {
                                            <MudTooltip Text="Este barco no recibirá avisos por email">
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" 
                   Variant="Variant.Text">
            Cancelar
        </MudButton>
        <MudButton OnClick="Aceptar" 
                   Color="Color.Primary" 
                   Variant="Variant.Filled"
                   Disabled="@(!_tempSeleccionBarcos.Any())"
                   StartIcon="@Icons.Material.Filled.Check">
            Confirmar (@_tempSeleccionBarcos.Count)
        </MudButton>
    </DialogActions>
</MudDialog>

