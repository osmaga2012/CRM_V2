@page "/empresas/importar"

@inject IApiClient<ExcelImportRequest> servicioImport 


@using System.Data
@using CRM.Dtos
@using ExcelDataReader
@using CRM.Dtos.Request


<div class="p-6 bg-slate-50 min-h-screen relative">
    @if (isProcessing)
    {
        @* Overlay de carga *@
        <div class="absolute inset-0 bg-white/70 backdrop-blur-sm z-50 flex flex-col items-center justify-center">
            <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-primary mb-4"></div>
            <h3 class="text-xl font-bold text-slate-800">Procesando archivo...</h3>
            <p class="text-slate-600">Esto puede tardar unos segundos dependiendo del tamaño del Excel.</p>
        </div>
    }

    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 p-8 @(isProcessing ? "opacity-50 pointer-events-none" : "")">
        <h2 class="text-2xl font-bold text-slate-800 mb-6">Actualización Masiva de Empresas</h2>

        @* ... (Selector de archivo y tabla de mapeo) *@

        @* 1. Selector de Archivo *@
        <div class="mb-8 p-4 border-2 border-dashed border-slate-300 rounded-xl text-center">
            <InputFile OnChange="OnInputFileChange" class="hidden" id="fileInput" />
            <label for="fileInput" class="cursor-pointer text-primary font-semibold hover:underline">
                Selecciona el archivo Excel (.xlsx)
            </label>
            @if (selectedFile != null)
            {
                <p class="mt-2 text-sm text-slate-600">📄 @selectedFile.Name</p>
            }
        </div>




        @if (excelHeaders.Any())
        {
            @* 2. Tabla de Mapeo *@
            <div class="overflow-hidden border border-slate-200 rounded-xl mb-6">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="p-4 font-semibold text-slate-700">Columna en Excel</th>
                            <th class="p-4 font-semibold text-slate-700">Campo en Base de Datos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var header in excelHeaders)
                        {
                            <tr class="border-t border-slate-100">
                                <td class="p-4 text-slate-600 font-mono text-sm">@header</td>
                                <td class="p-4">
                                    <select @onchange="@(e => UpdateMapping(header, e.Value.ToString()))"
                                            class="w-full p-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-primary/20 outline-none">
                                        <option value="">-- Ignorar --</option>
                                        <option value="EMail1">Email Principal (EMail1)</option>
                                        <option value="EMail2">Email Secundario (EMail2)</option>
                                        <option value="CodigoEmpresa">Codigo de Empresa</option>
                                        <option value="CodigoBarco">Codigo Barco</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <MudButton
                    Icon="@Icons.Material.Filled.Upload" @onclick="EnviarALaApi"
                    disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Iniciar Actualización</span>
                }
            </MudButton>
        }
    </div>
</div>


@code {
    private IBrowserFile selectedFile;
    private List<string> excelHeaders = new();
    private List<MapeoColumnas> finalMappings = new();
    private bool isProcessing = false;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        excelHeaders.Clear();
        finalMappings.Clear();

        // Leer cabeceras del Excel
        using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        using var reader = ExcelReaderFactory.CreateReader(memoryStream);
        var dataset = reader.AsDataSet() ;
        var mainTable = dataset.Tables[0];

        foreach (DataColumn column in mainTable.Rows[0].Table.Columns)
        {
            var columnName = mainTable.Rows[0][column].ToString();
            if (!string.IsNullOrEmpty(columnName))
                excelHeaders.Add(columnName);
        }
    }

    private void UpdateMapping(string excelCol, string dbProp)
    {
        finalMappings.RemoveAll(m => m.ColumnaExcel == excelCol);
        if (!string.IsNullOrEmpty(dbProp))
        {
            finalMappings.Add(new MapeoColumnas { ColumnaExcel = excelCol, ColumnaBaseDatos = dbProp });
        }
    }

    private async Task EnviarALaApi()
    {
        if (selectedFile == null || !finalMappings.Any()) return;

        try
        {
            // Aquí convertirás el archivo a Base64 y lo enviarás junto a finalMappings
            // a tu nuevo endpoint en la API.

            isProcessing = true;
            StateHasChanged();

            // 1. LEER EL ARCHIVO Y CONVERTIR A BASE64
            var buffer = new byte[selectedFile.Size];
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);

            // Es importante leer todo el stream al buffer
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var base64Content = Convert.ToBase64String(memoryStream.ToArray());

            var importData = new ExcelImportRequest
            {
                FileName = selectedFile.Name,
                ExcelBase64 = base64Content, // <--- ESTO FALTA EN TU CÓDIGO
                Mappings = finalMappings
            };

            await servicioImport.CreateAsync("api/Empresa/actualizar-empresas", importData);

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            //throw;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }   



    }
}