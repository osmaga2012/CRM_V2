@page "/barco/tramites"
@page "/barco/empresa/{CodigoEmpresa}/tramites/{CodigoBarco}"
@using CRM.Dtos
@using CRM.Dtos.Enums
@using Microsoft.AspNetCore.Components.QuickGrid
@using MudBlazor

<style>
  .fx-col { display:flex; flex-direction:column; }
  .fx-1 { flex: 1 1 auto; min-height: 0; } /* min-height:0 permite que el hijo calcule alturas y haga overflow */
  .vh-fill { min-height: calc(100vh - 32px); } /* ajusta 32px si cambias paddings/márgenes superiores */
</style> 


<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />
@* <MudPopoverProvider /> *@
<MudContainer MaxWidth="MaxWidth.False" Class="py-4 vh-fill">
    <MudGrid GutterSize="12">

        @* --- FORMULARIO DE GESTIÓN DE TRÁMITES --- *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="4" Class="rounded overflow-hidden border border-solid mud-border-lines-default">
                <MudToolBar Dense Class="mud-theme-primary rounded-0 px-4">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700; text-transform: uppercase;">
                        Gestión de Trámite
                    </MudText>
                </MudToolBar>

                <MudForm Model="@tramite" @ref="form" @bind-IsValid="success" Class="pa-6">
                    <MudStack Spacing="4">

                        <MudTextField Label="Nombre del Certificado"
                                      @bind-Value="tramite.Certificado"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge"
                                      Class="rounded" />

                        <MudGrid Spacing="2">
                            <MudItem xs="6">
                                <MudDatePicker Label="Inicio"
                                               @bind-Date="tramite.FechaInicioParser"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               DateFormat="dd/MM/yyyy"
                                               Class="rounded" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudDatePicker Label="Caducidad"
                                               @bind-Date="tramite.FechaFinParser"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               DateFormat="dd/MM/yyyy"
                                               Class="rounded" />
                            </MudItem>
                        </MudGrid>

                        <MudStack Row AlignItems="AlignItems.Center">
                            <MudTextField Label="Días de aviso"
                                          @bind-Value="tramite.DiasAvisoTramite"
                                          InputType="InputType.Number"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.End"
                                          AdornmentText="días"
                                          Class="rounded" />
                            <MudTooltip Text="Aviso X días antes de caducar.">
                                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Info" Size="Size.Small" />
                            </MudTooltip>
                        </MudStack>

                        <MudSelect T="TipoFrecuenciaDto?" @bind-Value="tramite.TipoFrecuencia"
                                   Label="Frecuencia de recordatorios"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="rounded"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="TipoFrecuenciaDto?" Value="@(TipoFrecuenciaDto.None)">Solo aviso inicial</MudSelectItem>
                            <MudSelectItem T="TipoFrecuenciaDto?" Value="@(TipoFrecuenciaDto.Diario)">1 vez al día</MudSelectItem>
                            <MudSelectItem T="TipoFrecuenciaDto?" Value="@(TipoFrecuenciaDto.Cada6Horas)">Cada 6 horas (4 veces/día)</MudSelectItem>
                            <MudSelectItem T="TipoFrecuenciaDto?" Value="@(TipoFrecuenciaDto.Cada3Horas)">Cada 3 horas (8 veces/día)</MudSelectItem>
                            <MudSelectItem T="TipoFrecuenciaDto?" Value="@(TipoFrecuenciaDto.Cada1Hora)">Cada hora (24 veces/día)</MudSelectItem>
                            <MudSelectItem T="TipoFrecuenciaDto?" Value="@(TipoFrecuenciaDto.Personalizado)">Personalizado</MudSelectItem>
                        </MudSelect>

                     @if (tramite.TipoFrecuencia == TipoFrecuenciaDto.Personalizado)
                     {
                         <MudStack Row AlignItems="AlignItems.Center">
                             <MudText Class="me-2">Recordatorio cada</MudText>
                             <MudTextField @bind-Value="tramite.CadaXHoras"
                                             InputType="InputType.Number"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="1" Max="168"
                                             Style="max-width: 80px;"
                                             Class="rounded" />
                             <MudText>horas (hasta la caducidad)</MudText>
                         </MudStack>
                    } 

                        <MudTextField Label="Observaciones"
                                      @bind-Value="tramite.Observaciones"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Class="rounded" />

                        @* Emails Section *@
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Class="font-bold">NOTIFICAR A:</MudText>
                            <MudTextField @bind-Value="_emailInput"
                                          Placeholder="email@ejemplo.com + Enter"
                                          OnKeyDown="OnEmailKeyDown"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email"
                                          Class="rounded" />

                            <div class="d-flex flex-wrap gap-1 mt-2">
                                @foreach (var mail in EmailsAviso)
                                {
                                    <MudChip T="string" Text="@mail"
                                             Color="Color.Primary"
                                             Variant="Variant.Filled"
                                             Size="Size.Small"
                                             OnClose="@((c) => RemoveEmail(c.Text))"
                                             Class="rounded" />
                                }
                            </div>
                        </MudStack>

                        @* Adjunto - Estilo Mejorado *@
                        <div class="file-upload-zone">
                            <MudText Typo="Typo.caption" Class="font-bold mb-1 d-block">DOCUMENTO ADJUNTO</MudText>
                            <div class="d-flex align-center border border-dashed pa-2">
                                <InputFile OnChange="OnFileChanged" id="fileInput" hidden />
                                <MudIconButton HtmlTag="label" for="fileInput"
                                               Icon="@Icons.Material.Filled.CloudUpload"
                                               Color="Color.Primary" />
                                <MudText Typo="Typo.caption" Class="ml-2 truncate">
                                    @(_selectedFileName ?? existingFileName ?? "Sin archivo")
                                </MudText>
                                <MudSpacer />
                                @if (!string.IsNullOrEmpty(_selectedFileName))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="ClearSelectedFile" />
                                }
                            </div>
                        </div>

                        @* Acciones Formulario *@
                        <MudStack Row Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth
                                       Class="rounded py-2"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="Submit">
                                Guardar Trámite
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Class="rounded py-2">
                                Cancelar
                            </MudButton>
                        </MudStack>

                    </MudStack>
                </MudForm>
            </MudPaper>
        </MudItem>

        @* --- LISTADO DE TRÁMITES --- *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="1" Class="p-0 rounded overflow-hidden">
                <MudToolBar>
                    <MudText Typo="Typo.subtitle1">Certificados del buque</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_filtroTramites"
                                  Placeholder="Buscar por nombre, NIF..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="max-w-64" />
                </MudToolBar>

                <MudTable Items="tramites" Dense="true" Hover="true" Bordered="true" Class="mt-4">
                    <HeaderContent>
                        <MudTh>Nombre Certificado</MudTh>
                        <MudTh>Fecha Cad.</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Certificado</MudTd>
                        <MudTd>@context.FechaFin.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd>
                            <div class="d-flex gap-1 justify-end">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditarTramite(context.Id))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmarBorrado(context))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

    </MudGrid>
</MudContainer>
<!-- Diálogo confirmación de borrado -->
<MudDialog @bind-IsVisible="_confirmVisible">
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Borrar trámite</MudText>
            <MudText>¿Seguro que quieres borrar <b>@_toDelete?.Certificado</b>?</MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => _confirmVisible = false">Cancelar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="BorrarConfirmado">Borrar</MudButton>
    </DialogActions>
</MudDialog>
