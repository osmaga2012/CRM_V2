@page "/barcos"
@using CRM.App.Shared.Interfaces
@using CRM.App.Shared.Services
@using CRM.Dtos
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.Linq

<MudThemeProvider />
<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-8 pt-4">

    <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">Centros de Trabajo - Barcos</MudText>

        <MudStack Row Spacing="2">
            <MudButton OnClick='() => NavigationManager.NavigateTo("/empresas/importar")'
                        Color="Color.Primary">
                <span class="material-symbols-outlined">upload_file</span>
                Actualización por Excel
            </MudButton>
        </MudStack>
    </MudStack>

    <div class="tramites-toolbar mb-4">
        <MudTextField @bind-Value="_filtroBarco"
                      Placeholder="Buscar por nombre, armador, capitán..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0 w-full" />
    </div>

    <MudPaper Elevation="4" Class="overflow-hidden border border-solid mud-border-lines-default">
        <div class="grid-container p-4">
            @if (IsLoading)
            {
                <MudProgressCircular Indeterminate="true" Class="m-auto" />
            }
            else if (PlatformService.IsNativeApp || IsMobile)
            {
                <div class="barcos-cards">
                    @foreach (var e in (FiltroEmpresas ?? Enumerable.Empty<EmpresasDto>()))
                    {
                        <article class="barco-card m-2 rounded-2 shadow" @key="e.CodigoEmpresa">
                            <div class="barco-card-body p-2" @onclick="() => OpenTramites(e.CodigoEmpresa, e!.Barco!)" style="cursor:pointer">
                                <h3 class="barco-title">@e.Barco?.NombreA</h3>
                                <p class="barco-sub">Empresa: @e.Empresa</p>
                                <p class="barco-sub">Cód. Barco: @e.CodigoBarco</p>
                                <p class="barco-sub">Armador: @e.NombreArmador</p>
                                <p class="barco-sub">Email1: @e.EMail1</p>
                                <p class="barco-sub">EMail2: @e.EMail2</p> 
                            </div>
                            <div class="barco-card-footer p-2">
                                <MudButton Variant="Variant.Text" OnClick="@(async () => await OpenTramitesAsync(e.CodigoEmpresa, e.Barco))">Ver Trámites</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="@(async () => await VerUsuariosBarco(e))">Usuarios</MudButton>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <MudTable Items="FiltroEmpresas" RowsPerPage="10" Dense="true" Hover="true" Bordered="true" Class="mud-elevation-4">
                    <HeaderContent>
                        <MudTh>Cód. Barco</MudTh>
                        <MudTh>Nombre Barco</MudTh>
                        <MudTh>Cód. Empresa</MudTh>
                        <MudTh>Empresa</MudTh>
                        <MudTh>Armador</MudTh>
                        <MudTh>Matriz</MudTh>
                        <MudTh>Email1</MudTh>
                        <MudTh>Email2</MudTh>
                        <MudTh>Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Cód. Barco">@context.Barco?.CodigoBarco</MudTd>
                        <MudTd DataLabel="Nombre Barco">@context.Barco?.NombreB</MudTd>
                        <MudTd DataLabel="Cód. Empresa">@context.CodigoEmpresa</MudTd>
                        <MudTd DataLabel="Empresa">@context.Empresa</MudTd>
                        <MudTd DataLabel="Armador">@context.NombreArmador</MudTd>
                        <MudTd DataLabel="Matriz">@context.EmpresaMatriz</MudTd>
                        <MudTd DataLabel="Email1">@context.EMail1</MudTd>
                        <MudTd DataLabel="Email2">@context.EMail2</MudTd>
                        <MudTd DataLabel="Acciones">
                            <MudIconButton Icon="@Icons.Material.Filled.Dock" Size="Size.Small" OnClick="@(() => OpenTramitesAsync(context.CodigoEmpresa, context.Barco))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Person4" Size="Size.Small" OnClick="@(() => VerUsuariosBarco(context))" />
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
                    </PagerContent>
                </MudTable>
            }
        </div>
    </MudPaper>
</MudContainer>

